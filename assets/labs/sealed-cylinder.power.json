      },
      "position": {
        "value": 180,
        "unit": "deg"
      }
    },
    {
      "id": 2,
      "domain": "thermal",
      "storage": {
        "value": 500,
        "unit": "j_k"
      },
      "initial": {
        "value": 300,
        "unit": "k"
      }
    }
  ],
  "components": [
    {
      "id": 10,
      "kind": "sealed_cylinder",
      "node_a": 1,
      "parameters": {
        "bore": {
          "value": 86,
