{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power model and reproducible experiment v1",
  "description": "Units are explicit; references, dimensions, positivity, aligned times and numerical feasibility are validated by the Power compiler. Synthetic input must not be treated as calibrated evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "step_ns",
    "nodes",
    "components",
    "experiment"
  ],
  "properties": {
    "schema": {
      "const": "power.model.v1"
    },
    "description": {
      "type": "string"
    },
    "step_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/rotor"
          },
          {
            "$ref": "#/$defs/thermal"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "components": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/shaft"
          },
          {
            "$ref": "#/$defs/motor"
          },
          {
            "$ref": "#/$defs/torque"
          },
          {
            "$ref": "#/$defs/thermal_link"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 64
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    }
  },
  "$defs": {
    "rotor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "storage",
        "initial",
        "position"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "domain": {
          "const": "rotational"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "kg_m2"
              ]
            }
          }
        },
        "initial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "rad_s",
                "rpm"
              ]
            }
          }
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "rad",
                "deg"
              ]
            }
          }
        }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "storage",
        "initial"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "domain": {
          "const": "thermal"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "j_k"
              ]
            }
          }
        },
        "initial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "k"
              ]
            }
          }
        }
      }
    },
    "shaft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "node_a",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "kind": {
          "const": "shaft"
        },
        "node_a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "node_b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "heat_node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stiffness",
            "damping",
            "ratio",
            "rest_angle"
          ],
          "properties": {
            "stiffness": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "nm_rad"
                  ]
                }
              }
            },
            "damping": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "nm_s_rad"
                  ]
                }
              }
            },
            "ratio": {
              "type": "number",
              "not": {
                "const": 0
              }
            },
            "rest_angle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "rad",
                    "deg"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "motor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "node_a",
        "input_channel",
        "initial_input",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "kind": {
          "const": "dc_motor"
        },
        "node_a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "heat_node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "input_channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "initial_input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "v"
              ]
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resistance",
            "inductance",
            "coupling",
            "initial_current"
          ],
          "properties": {
            "resistance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "ohm"
                  ]
                }
              }
            },
            "inductance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "h"
                  ]
                }
              }
            },
            "coupling": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "nm_a"
                  ]
                }
              }
            },
            "initial_current": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "a"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "torque": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "node_a",
        "input_channel",
        "initial_input"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "kind": {
          "const": "torque_source"
        },
        "node_a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "input_channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "initial_input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "nm"
              ]
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    "thermal_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "node_a",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "kind": {
          "const": "thermal_link"
        },
        "node_a": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "node_b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conductance"
          ],
          "properties": {
            "conductance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "w_k"
                  ]
                }
              }
            },
            "ambient_temperature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "k"
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "node_b"
                  ]
                }
              },
              {
                "properties": {
                  "node_b": {
                    "const": 0
                  }
                },
                "required": [
                  "node_b"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "required": [
                  "ambient_temperature"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "parameters": {
                "not": {
                  "required": [
                    "ambient_temperature"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ns",
        "sample_every_ns"
      ],
      "properties": {
        "duration_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000000000
        },
        "sample_every_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000000000
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 0,
          "maxItems": 256
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ns",
        "values"
      ],
      "properties": {
        "time_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599999999999
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "value"
            ],
            "properties": {
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "value": {
                "type": "number"
              }
            }
          },
          "minItems": 1,
          "maxItems": 64
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "field"
      ],
      "properties": {
        "object_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "field": {
          "enum": [
            "angle",
            "speed",
            "temperature",
            "current",
            "twist",
            "torque",
            "source_work",
            "heat_rejected",
            "stored_energy_change",
            "energy_residual"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "abs_max": {
          "type": "number",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "abs_max"
          ]
        }
      ]
    }
  }
}
