.studio { flex-grow: 1; color: rgb(222, 234, 241); }
.viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.header { position: absolute; top: 0; left: 0; right: 0; height: 96px; padding: 22px 40px; flex-direction: row; align-items: center; background-color: rgba(8, 15, 21, 0.94); border-bottom-width: 1px; border-bottom-color: rgb(39, 53, 62); }
.brand { flex-direction: row; align-items: center; flex-grow: 1; }
.wordmark { font-size: 30px; -unity-font-style: bold; letter-spacing: -1px; margin-right: 24px; color: rgb(117, 240, 191); }
.eyebrow { font-size: 11px; letter-spacing: 1.7px; color: rgb(143, 162, 173); }
.status { font-size: 11px; letter-spacing: 1px; color: rgb(117, 240, 191); margin-right: 32px; }
.clock { font-size: 22px; color: rgb(235, 243, 247); }
.scene-title { position: absolute; left: 40px; top: 132px; }
.hero-title { font-size: 42px; -unity-font-style: bold; letter-spacing: -1.4px; margin-top: 8px; margin-bottom: 8px; }
.subtitle { font-size: 14px; color: rgb(162, 184, 196); margin-bottom: 12px; }
.hint { font-size: 11px; color: rgb(130, 151, 165); }
.controls { position: absolute; top: 140px; right: 40px; width: 306px; padding: 22px; background-color: rgba(12, 23, 31, 0.96); border-width: 1px; border-color: rgb(42, 61, 73); border-radius: 12px; }
.control-title { font-size: 14px; }
.input-list { max-height: 120px; margin-top: 12px; }
.input-list .unity-text-field { margin-top: 6px; margin-bottom: 6px; }
.input-list .unity-base-field__label { min-width: 110px; font-size: 11px; }
.output-list { height: 150px; margin-top: 18px; }
.output-row { flex-direction: row; justify-content: space-between; margin-bottom: 8px; }
.output-row .hint { max-width: 165px; white-space: normal; }
.output-value { font-size: 11px; color: rgb(222, 234, 241); }
.accent-value { color: rgb(117, 240, 191); font-size: 18px; -unity-font-style: bold; }
.row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12px; margin-bottom: 6px; }
.controls .unity-slider { height: 30px; margin-top: 12px; margin-bottom: 8px; }
.controls .unity-slider__dragger { background-color: rgb(117, 240, 191); border-color: rgb(117, 240, 191); }
.unity-button { background-color: rgb(29, 45, 56); color: rgb(224, 236, 244); border-width: 1px; border-color: rgb(53, 74, 89); border-radius: 6px; padding: 10px 12px; margin: 2px; font-size: 12px; }
.unity-button:hover { background-color: rgb(45, 66, 81); border-color: rgb(117, 240, 191); }
.unity-button:focus { border-color: rgb(117, 240, 191); }
.row .unity-button { flex-grow: 1; }
.primary-button { margin-top: 12px; margin-bottom: 12px; background-color: rgb(117, 240, 191); color: rgb(8, 31, 25); -unity-font-style: bold; }
.primary-button:hover { background-color: rgb(152, 255, 215); }
.telemetry { position: absolute; left: 40px; right: 40px; bottom: 64px; padding: 20px 26px; background-color: rgba(9, 19, 27, 0.96); border-width: 1px; border-color: rgb(42, 61, 73); border-radius: 12px; }
.metrics { flex-direction: row; margin-bottom: 16px; }
.metric { flex-grow: 1; flex-basis: 0; border-left-width: 1px; border-left-color: rgb(42, 61, 73); padding-left: 20px; }
.metric-value { font-size: 28px; margin-top: 6px; }
.mint { color: rgb(117, 240, 191); }
.blue { color: rgb(117, 181, 255); }
.telemetry-plot { height: 100px; margin-top: 6px; }
.footer { position: absolute; left: 40px; right: 40px; bottom: 24px; flex-direction: row; justify-content: space-between; }
